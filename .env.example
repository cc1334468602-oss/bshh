# ==========================================================
# bshh 前台 H5 —— 环境变量模板
# 用法：cp .env.example .env  然后填入真实值，最后 chmod 600 .env
# 注意：.env 已被 .gitignore 排除，切勿提交到仓库
# ==========================================================

# ---- 服务监听 ----
PORT=9191
# 生产环境填 127.0.0.1（只允许 Nginx 转发）；本地开发可填 0.0.0.0
HOST=127.0.0.1

# ---- 共享配置文件（与后台 bshhadmin 指向同一路径）----
# 后台在「简道云接口」页面保存配置后写入此文件，前台实时读取，无需重启
JDY_CONFIG_PATH=/var/www/shared/jdy-config.json

# ---- 简道云凭证（兜底用）----
# 共享配置文件存在时以其为准；此处作为文件缺失时的兜底
# 从简道云「开放平台 → 密钥管理」获取
JDY_API_KEY=
JDY_APP_ID=

# ---- 表单 entry_id ----
# 从简道云表单页 URL 中 form/ 后面那段获取
JDY_ENTRY_CUSTOMER=
JDY_ENTRY_LOAN=
JDY_ENTRY_LOAN_HISTORY=
JDY_ENTRY_CASHFLOW=
JDY_ENTRY_INTENTION=
JDY_ENTRY_FOLLOWUP=
JDY_ENTRY_REPAYMENT=

# ---- MySQL 数据库（全量业务数据落地）----
# 启用数据库：填好 DB_HOST 与 DB_PASS 后，系统自动以 MySQL 为主数据源。
# 不填则自动回退到简道云（可选）与前端 Mock 演示数据。
DB_HOST=localhost
DB_PORT=3306
DB_USER=bshh_user
DB_PASS=Bshh@2026
DB_NAME=bshh_db
